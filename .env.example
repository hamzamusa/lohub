# Compliance daily digest via Slack (cron GET /api/compliance/digest)
# Uses the same Slack config as other compliance alerts:
# SLACK_BOT_TOKEN=
# COMPLIANCE_ALERT_SLACK_CHANNEL=
# CRON_SECRET=
# NEXT_PUBLIC_APP_URL=https://mutual-aid-portal.vercel.app

# F1 upload → Google Sheets Activities append (POST /api/sheets/update). Off unless explicitly true.
# SHEETS_F1_APPEND_ENABLED=false
# NEXT_PUBLIC_SHEETS_F1_APPEND_ENABLED=false
# When enabling: set both to true; GOOGLE_SHEET_ID + GOOGLE_VISION or GOOGLE_SHEETS credentials.
